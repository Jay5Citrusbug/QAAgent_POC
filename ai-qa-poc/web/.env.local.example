# Copy to .env.local and add your key. Never commit .env.local.
#
# Add any provider keys you want to make available in the model picker.
# The API selects the provider from the model id and only exposes providers
# whose key is configured.
# Get an Anthropic key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Get an OpenAI key at https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Gemini accepts either variable name. Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# GOOGLE_API_KEY=...

# Optional: comma-separated model ids not listed in the built-in picker.
# The provider is inferred from claude-, gpt-/o-, or gemini-/gemma- prefixes.
# AI_MODELS=gpt-4.1,gemini-2.5-flash
