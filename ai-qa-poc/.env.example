# Copy to .env and fill in. Never commit .env.

BASE_URL=https://buggyqa.vercel.app/

# HEADED=false runs headless. Default is headed - for a POC, watching it work
# is most of the value.
HEADED=true

# Slow the browser down (ms per action) when demoing.
SLOW_MO=0

# Build or commit under test, surfaced in the report.
BUILD=unknown

# Optional post-execution AI triage. It never changes PASS/FAIL.
EXECUTION_AI=false
# Runs on your Claude subscription through Claude Code (claude -p) — no API key.
# AI_PROVIDER=claude-cli        # claude-cli | api | off  (auto prefers the subscription)
# EXECUTION_AI_MODEL=claude-opus-5
# ANTHROPIC_API_KEY=            # only if you choose AI_PROVIDER=api (metered)

# Optional: fetch stories live with `npm run story -- --jira KEY`.
# Without these, export the ticket (JSON/XML) or paste its text instead.
# JIRA_BASE_URL=https://your-company.atlassian.net
# JIRA_EMAIL=you@company.com       # Cloud
# JIRA_API_TOKEN=                  # Cloud: id.atlassian.com → Security → API tokens
# JIRA_PAT=                        # Server / Data Center instead of email + token
# JIRA_AC_FIELD=customfield_10035  # if acceptance criteria live in a custom field

# Optional: scripted sign-in per role (see "login:" under roles in the app context).
# The app context names these VARIABLES; the values live only here, never in a committed file.
# STAGE_CUSTOMER_USER=
# STAGE_CUSTOMER_PASSWORD=
# STAGE_API_TOKEN=               # only if a role's api_auth uses token_env
