# Copy to .env and fill in. Never commit .env.

BASE_URL=https://buggyqa.vercel.app/

# HEADED=false runs headless. Default is headed - for a POC, watching it work
# is most of the value.
HEADED=true

# Slow the browser down (ms per action) when demoing.
SLOW_MO=0

# Build or commit under test, surfaced in the report.
BUILD=unknown

# Optional post-execution AI triage. It never changes PASS/FAIL.
EXECUTION_AI=false
EXECUTION_AI_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=your-key-here
