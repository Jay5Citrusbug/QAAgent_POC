{
  "test_id": "SM-006",
  "requirement_ref": {
    "source": "DOC",
    "locator": "input/feature/requirement.md",
    "quote": "A \"Shop by Category\" section with interactive buttons to filter products by: All, Electronics, Fashion, and Books.",
    "content_hash": "sha256:2f4a3b02b9e13b375cec84f00278283e"
  },
  "feature": "Product Filtering & Categorization",
  "module": "ProductGrid",
  "capability": "ProductGrid.FilterByCategory",
  "priority": "P1",
  "role": "guest",
  "environment": "STAGE",
  "auth": {
    "strategy": "anonymous"
  },
  "starting_context": {
    "page": "Home",
    "location": "Shop by Category section"
  },
  "preconditions": [
    "Application is loaded at the home page",
    "Product grid contains items from at least Electronics and Fashion categories"
  ],
  "test_objective": "Verify clicking the Electronics category filter button updates the product grid to show only Electronics items.",
  "expected_outcome": "succeeds",
  "actions": [
    {
      "action": "navigate",
      "instruction": "Go to the home page.",
      "url": "/"
    },
    {
      "action": "click",
      "instruction": "Click the Electronics category filter button.",
      "target": {
        "description": "Electronics category filter button",
        "role": "button",
        "name": "Electronics"
      }
    }
  ],
  "assertions": [
    {
      "id": "A1",
      "statement": "The Electronics filter button shows an active/selected state after being clicked.",
      "check": {
        "type": "attribute_equals",
        "target": {
          "description": "Electronics category filter button",
          "role": "button",
          "name": "Electronics"
        },
        "attribute": "aria-pressed",
        "value": "true"
      },
      "critical": false
    },
    {
      "id": "A2",
      "statement": "All visible product cards in the grid are tagged with the Electronics category after filtering.",
      "check": {
        "type": "count",
        "target": {
          "description": "Category tags on visible product cards not equal to Electronics",
          "role": "generic",
          "name": "category-tag",
          "expect_multiple": true
        },
        "value": 0
      }
    }
  ],
  "evidence_policy": {
    "screenshot": "on_assertion",
    "trace": "retain_on_failure",
    "console": false,
    "network": false,
    "snapshot_on_failure": true
  },
