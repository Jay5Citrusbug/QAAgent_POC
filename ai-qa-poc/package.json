{
  "name": "ai-qa-poc",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven functional smoke testing POC. Thinking Agent proposes, human approves, Execution Agent drives Playwright.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "new-feature": "tsx scripts/new-feature.ts",
    "story": "tsx scripts/story.ts",
    "preflight": "tsx scripts/preflight.ts",
    "inspect": "tsx scripts/inspect.ts",
    "think": "tsx scripts/think.ts",
    "thinker": "tsx scripts/think.ts --run --agent thinker",
    "test-case-agent": "tsx scripts/think.ts --run --agent test-case",
    "clarify": "tsx scripts/clarify.ts",
    "import": "tsx scripts/import.ts",
    "validate": "tsx scripts/validate.ts",
    "verify": "tsx scripts/verify.ts",
    "heal": "tsx scripts/heal.ts",
    "test-cases": "tsx scripts/test-cases-report.ts",
    "approve": "tsx scripts/approve.ts",
    "approve-analysis": "tsx scripts/approve-analysis.ts",
    "approve-intent": "tsx scripts/approve-intent.ts",
    "approve-sheet": "tsx scripts/approve-sheet.ts",
    "decide": "tsx scripts/decide.ts",
    "run-mission": "tsx scripts/run.ts",
    "run-headless": "tsx scripts/run.ts --headless",
    "execution-agent": "tsx scripts/run.ts",
    "explore": "tsx scripts/explore.ts",
    "bind": "tsx scripts/bind.ts",
    "defects": "tsx scripts/defects.ts",
    "coverage": "tsx scripts/coverage.ts",
    "metrics": "tsx scripts/metrics.ts",
    "report": "tsx scripts/report.ts",
    "status": "tsx scripts/status.ts",
    "execution-report": "tsx scripts/execution-report.ts",
    "promote": "tsx scripts/promote.ts",
    "visual": "tsx scripts/visual.ts",
    "access-matrix": "tsx scripts/access-matrix.ts",
    "regression": "playwright test",
    "browsers": "playwright install chromium",
    "browsers:all": "playwright install chromium firefox webkit",
    "auth": "tsx scripts/auth.ts",
    "web": "npm --prefix web run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@playwright/test": "^1.49.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "yaml": "^2.6.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
